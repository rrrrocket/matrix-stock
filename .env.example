# 本地开发可保持 STOCK_DEBUG=1；正式部署请设置为 0 并更换所有密钥。
STOCK_DEBUG=1
STOCK_SECRET_KEY=replace-with-a-long-random-value
STOCK_ADMIN_USERNAME=admin
STOCK_ADMIN_PASSWORD=admin
STOCK_ALLOWED_HOSTS=localhost,127.0.0.1
STOCK_ERP_API_KEY=replace-with-an-independent-long-random-value
STOCK_ERP_RETURN_ORIGINS=http://localhost:3000
